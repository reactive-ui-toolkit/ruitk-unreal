# ── Unreal Engine generated (project root AND Plugins/*/ via unrooted patterns) ──
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/

# Visual Studio / IDE artifacts
.vs/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# clangd compile database (generated per-machine via UnrealBuildTool -mode=GenerateClangDatabase)
compile_commands.json
.cache/

# ── Reactive UI Toolkit machine-local outputs ──
# Diagnostics sidecars are per-machine compiler state (MASTER_PLAN D-18); the compiler
# fingerprint lives under Saved/ (already ignored). Generated .uetkx.inl and
# <Module>.Uetkx.gen.cpp are COMMITTED on purpose (D-19) — do not ignore them.
*.uetkx.diags.json

# Local publish-token mirror for the manual publish rail (scripts/*.ps1) — never commit.
publisher-secrets.json

# This machine's irreducible paths (engine root, clang-format) — the ONE place a machine-local path
# may live. Copy the tracked `.ruitk-local.example.json` and fill in only what discovery can't find.
# See CLAUDE.md "Machine-local paths"; scripts/check-machine-paths.mjs gates the rest of the tree.
.ruitk-local.json

# ── Node trees (docs site, ide-extensions) ──
node_modules/
RuitkUnrealDocs~/dist/
ide-extensions/lsp-server/out/
ide-extensions/vscode-uetkx/out/
ide-extensions/vscode-uetkx/*.vsix

# The owner's ad-hoc scratch file for pasting CI/editor error output (the field-test-editor
# skill reads it; never committed).
/Errors

# OS noise
Thumbs.db
.DS_Store

# IDE-extension build artifacts (bundled at package time, never committed)
ide-extensions/lsp-server/out/
ide-extensions/vscode-uetkx/out/
ide-extensions/vscode-uetkx/server/
ide-extensions/visual-studio/UetkxVsix/server/
ide-extensions/visual-studio/UetkxVsix/bin/
ide-extensions/visual-studio/UetkxVsix/obj/
scripts/diff-reports/

# §5: staged clangd bundles (fetch-clangd.mjs output — 28MB of LLVM binaries never enter git;
# fetched + sha256-verified at package time and in CI)
ide-extensions/vscode-uetkx/clangd/
ide-extensions/.clangd-staged-aside/
ide-extensions/visual-studio/UetkxVsix/clangd/

# UBT VSCode-generator compile databases (machine-local absolute paths)
.vscode/compileCommands_*
.vscode/compileCommands_*/
.vscode/c_cpp_properties.json
RuitkUnrealDemo.code-workspace
# …and the same generator's output from before the 0.15.0 rebrand (old project name) — still
# regenerated on machines whose UBT config predates the rename; names absolute engine +
# checkout paths, so it may never be committed (machine-local-paths R2).
ReactiveUIUnrealDemo.code-workspace

# Personal search-scope file (ripgrep/VS Code search read it): keeps bulk UE dirs and non-code
# trees out of THIS machine's searches. Committing it would silently narrow every contributor's
# (and CI tooling's) searches — keep it local.
/.ignore

# vs2022 overview.md is GENERATED at publish time from overview-template.md (see release-process)
ide-extensions/visual-studio/UetkxVsix/overview.md

# Per-engine packaging output (scripts/package-plugin.ps1 + publish.yml) — zips + staging trees
/dist/
