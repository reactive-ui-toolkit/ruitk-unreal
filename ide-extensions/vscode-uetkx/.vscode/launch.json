{
  // F5 flow: builds the extension + bundles the language server (preLaunchTask), then opens
  // an Extension Development Host with the repo loaded so the gallery .uetkx files are right
  // there to poke. Breakpoints work in src/extension.ts; for SERVER-side breakpoints use the
  // "Attach to UETKX Language Server" config after the host is up (the server runs with
  // --inspect=6010 in debug).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run UETKX Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        // The dev host opens the .code-workspace (whose single folder is `../..` = the repo root),
        // NOT the bare folder: a folder can't restore UI state into two windows, so the workspace
        // file gives the host its own identity and open editors survive an F5 cycle.
        // ${workspaceFolder} — never a written-down absolute path. This line used to hardcode one,
        // the rebrand sweep rewrote the repo-folder segment inside it, and F5 broke for every clone
        // whose folder name differs (see CLAUDE.md "Machine-local paths").
        "${workspaceFolder}/uetkx-dev.code-workspace"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Attach to UETKX Language Server",
      "type": "node",
      "request": "attach",
      "port": 6010,
      "restart": true,
      "outFiles": ["${workspaceFolder}/server/**/*.js"]
    }
  ]
}
