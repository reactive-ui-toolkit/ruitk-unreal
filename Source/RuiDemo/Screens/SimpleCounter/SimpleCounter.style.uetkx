// SimpleCounter.style.uetkx — the screen's shared style values (value-export companion,
// same pattern as ContextDemo.style.uetkx). Element-attr margins are real FMargin values;
// Slot.* paddings stay strings (FRuiValue has no FMargin kind — the slot dict parses the
// "l,t,r,b" literal at apply time).

export FLinearColor CounterPanelBackground = { 0.02f, 0.02f, 0.03f, 0.85f };

export FMargin PanelPadding = { 12.0f };

export FMargin ButtonPadding = { 12.0f, 4.0f };

export FVector2D RowGap = { 1.0f, 6.0f };

export FString PanelSlotPadding = TEXT("0,10,0,0");

export FString ButtonSlotPadding = TEXT("0,0,6,0");
