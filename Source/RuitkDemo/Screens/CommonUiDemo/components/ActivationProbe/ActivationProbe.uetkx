// Reads the activation context its parent screen provides — a real URuitkActivatableScreen provides the
// same state when it (de)activates on a CommonUI stack. Must be a descendant of the provider.
export FRuitkNode ActivationProbe() {
	const bool bActive = Ruitk::CommonUI::UseIsActive();
	const ERuitkInputMethod Method = Ruitk::CommonUI::UseInputMethod();
	const FString MethodStr = Method == ERuitkInputMethod::Gamepad ? TEXT("Gamepad")
									: Method == ERuitkInputMethod::Touch ? TEXT("Touch")
																	: TEXT("Mouse & Keyboard");
	return (
		<VerticalBox>
			<TextBlock Text={ Ruitk::Fmt(TEXT("Screen is {}"), bActive ? TEXT("ACTIVE") : TEXT("INACTIVE")) } />
			<TextBlock Text={ Ruitk::Fmt(TEXT("Input method: {}"), MethodStr) } />
		</VerticalBox>
	);
}
