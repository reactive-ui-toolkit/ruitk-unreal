import { UseCounter } from "./SimpleCounter.hooks"
import { PanelBackground, PanelPadding, ButtonPadding, RowGap, PanelSlotPadding, ButtonSlotPadding } from "./SimpleCounter.style"

export FRuitkNode SimpleCounter() {
	// const FString& Title = UseMemo<FString>([]() { return FString(TEXT("DOOM COUNTERaaaaaaaaaaaa")); }, Ruitk::Deps());
	auto [Count, Increment] = UseCounter(0);
	auto [Count2, Increment2] = UseState<int32>(0);

	return (
		<Border
			Padding={ PanelPadding }
			BorderImage="WhiteBrush"
			BorderBackgroundColor={ PanelBackground }
			Slot.Padding={ PanelSlotPadding }
		>
			<VerticalBox>
				<TextBlock Text={ FText::FromString(TEXT("DOOM COUNTER02")) } />
				<TextBlock Text={ Ruitk::Fmt(TEXT("Count1: {}"), Count) } />
				<TextBlock Text={ Ruitk::Fmt(TEXT("Count2: {}"), Count2) } />
				<Spacer Size={ RowGap } />
				<HorizontalBox>
					<Button
						OnClicked={ Increment() }
						ContentPadding={ ButtonPadding }
						Slot.Padding={ ButtonSlotPadding }
					>
						+
					</Button>
				</HorizontalBox>
				<HorizontalBox>
					<Button
						OnClicked={ Increment2([](const int32& Prev) { return Prev + 1; }) }
						ContentPadding={ ButtonPadding }
						Slot.Padding={ ButtonSlotPadding }
					>
						+
					</Button>
				</HorizontalBox>
			</VerticalBox>
		</Border>
	);
}
